<?xml version="1.0" encoding="utf-8"?>
<component name="ChannelStrip" extends="Group">
  <interface>
    <field id="themeColors" type="assocarray" onChange="render" />
    <field id="channels" type="array" onChange="updateChannels" />
    <field id="channelId" type="string" onChange="syncTunedChannel" />
    <field id="selectedId" type="string" alwaysNotify="true" />
    <field id="accent" type="color" value="0xE7C584FF" onChange="render" />
  </interface>
  <script type="text/brightscript" uri="ChannelStrip.brs" />
  <script type="text/brightscript" uri="ThemeStyle.brs" />
  <children />
</component>
