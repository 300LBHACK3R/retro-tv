{
  "name": "retro-tv",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based retro cable TV simulator built with Next.js, TypeScript, Tailwind CSS, Supabase, and Cloudflare R2.",
  "scripts": {
    "prepare:portraits": "node scripts/prepare-portraits.mjs",
    "predev": "npm run prepare:portraits",
    "prebuild": "npm run prepare:portraits",
    "dev": "node scripts/dev.mjs",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build && node tests/styles.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "clean": "node -e \"const fs=require('fs'); ['.next','out','dist','build','tsconfig.tsbuildinfo','playwright-report','playwright-report-billing','test-results','test-results-billing','coverage'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "audit:prod": "npm audit --omit=dev",
    "test:unit": "playwright test --config tests/unit.config.ts",
    "test:browser": "playwright test",
    "test:http": "node tests/http.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.87.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^23.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
