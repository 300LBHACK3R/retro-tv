# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/media/
*.mp4
*.mov
*.mkv
.history/

# Local browser QA captures and test harness
/.qa/

/playwright-report/
/test-results/

# Local caches and editor backup copies (never source)
/.turbo/
/.cache/
**/*.before-*
**/*.backup-*
**/*.repair-backup-*
**/* copy.*
**/* Copy.*

# One-time update downloads belong outside the project
/TatesTV-*.zip
/Update-TatesTV-*.ps1
/Start-TatesTV-*.ps1
/Repair-TatesTV-*.ps1
/Resume-TatesTV-*.ps1
/Publish-TatesTV-*.ps1
